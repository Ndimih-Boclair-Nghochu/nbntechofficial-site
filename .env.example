# ─────────────────────────────────────────────────────────────
# NBN TECH — environment variables
# Copy this file to `.env` (local) and set the same keys in Vercel.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon serverless Postgres) ──────────────────────
# From the Neon dashboard (or the Vercel <> Neon Marketplace integration).
# Use the POOLED connection string (host contains "-pooler") so it works in
# Vercel's serverless functions. Must include ?sslmode=require.
# Example: postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: a DIRECT (non-pooled) URL for running migrations locally.
# If unset, migrations fall back to DATABASE_URL. Host has NO "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js (NextAuth v5) ────────────────────────────────────
# Secret used to sign the session JWT. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# The single admin account. The site has NO public signup — this account is
# created by the seed script only. Set these to whatever you want; they are
# entirely yours.
ADMIN_EMAIL="admin@nbntech.dev"
ADMIN_NAME="NBN TECH Admin"

# ── Admin password — choose ONE of the two options below ─────
#
# Option A (simplest): set your password in plaintext here. The seed script
# hashes it for you (bcrypt) before storing it. You log in with this password.
ADMIN_PASSWORD="change-me-to-your-own-password"
#
# Option B (most secure — plaintext never stored in env): pre-compute a bcrypt
# hash and set it instead, leaving ADMIN_PASSWORD blank/removed.
# Generate with:  npm run hash -- "your-strong-password"
# ADMIN_PASSWORD_HASH="$2a$12$replace_this_with_a_real_bcrypt_hash_value_000000"
#
# If BOTH are set, ADMIN_PASSWORD_HASH wins.

# ── Vercel Blob (image uploads) ──────────────────────────────
# Create a Blob store in the Vercel dashboard (Storage tab) and copy the token.
# Locally you can run `vercel env pull` to fetch it into .env automatically.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXXXXXXXXXX"

# ── Public site URL (used for canonical/OG metadata) ─────────
# No trailing slash. On Vercel this is set automatically as VERCEL_URL, but set
# NEXT_PUBLIC_SITE_URL to your production domain for correct absolute URLs.
NEXT_PUBLIC_SITE_URL="https://nbntech.dev"
