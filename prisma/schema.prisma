// NBN TECH — Prisma schema
// Postgres (Neon serverless). Prisma Client is generated for the Neon adapter,
// which is wired up in lib/prisma.ts for Vercel's serverless runtime.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The single administrator. Only one row ever exists (created by the seed
/// script from ADMIN_EMAIL / ADMIN_PASSWORD_HASH). There is no public signup.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum SkillCategory {
  Frontend
  Backend
  Mobile
  CloudDevOps
  Other
}

model Skill {
  id          String        @id @default(cuid())
  name        String
  category    SkillCategory @default(Other)
  /// 1–100; optional visual proficiency meter.
  proficiency Int?
  /// A lucide-react icon name (e.g. "Cloud") OR an uploaded image URL.
  icon        String?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, order])
}

enum ProjectCategory {
  Web
  Mobile
  Desktop
  CloudDevOps
  Other
}

model Project {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  /// Short one/two-line summary for cards.
  summary       String
  /// Long-form case study body (Markdown supported).
  description   String
  role          String?
  techStack     String[]        @default([])
  coverImageUrl String?
  coverImageAlt String?
  gallery       String[]        @default([])
  liveUrl       String?
  githubUrl     String?
  featured      Boolean         @default(false)
  order         Int             @default(0)
  category      ProjectCategory @default(Web)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category, order])
  @@index([featured])
}

/// Singleton (single row, id = "singleton") holding all editable site-wide copy.
/// Lets the owner update hero/about/contact/SEO text from the admin without a
/// redeploy. Social links are stored as JSON.
model SiteContent {
  id                  String   @id @default("singleton")
  heroHeadline        String   @default("")
  heroSubheadline     String   @default("")
  heroPhotoUrl        String?
  heroPhotoAlt        String?
  positioningStatement String  @default("")
  aboutTitle          String   @default("")
  aboutText           String   @default("")
  aboutPhotoUrl       String?
  aboutPhotoAlt       String?
  contactEmail        String   @default("")
  contactHeadline     String   @default("")
  contactBody         String   @default("")
  /// { "linkedin": "...", "github": "...", "x": "...", "website": "..." }
  socialLinks         Json     @default("{}")
  metaTitle           String   @default("")
  metaDescription     String   @default("")
  updatedAt           DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  quote     String
  avatarUrl String?
  rating    Int      @default(5)
  /// Visitor-submitted reviews start unapproved; admin approves before display.
  approved  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved, order])
}

/// Messages sent from the public contact form — an admin inbox.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

/// Photos shown on the public gallery page + home gallery section.
model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String
  caption   String?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// NBN MARKET product.
///
/// The marketplace is a product-discovery / recommendation platform — it never
/// processes payments; the purchase happens on Amazon. `category` stores a
/// category slug (see lib/marketplace.ts) rather than an enum so new categories
/// can be added in config without a schema change.
///
/// JSON fields:
///   specs              — [{ "label": "...", "value": "..." }]
///   faqs               — [{ "q": "...", "a": "..." }]
///   amazonAvailability — { "DE": { status, url?, price?, currency? }, ... }
///                        status ∈ AVAILABLE | UNAVAILABLE | AVAILABILITY_UNKNOWN
model MarketProduct {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  brand            String?
  /// Category slug (e.g. "laptops", "courses"). Free-form: admins add new ones
  /// when creating a product, and syncs can set them automatically.
  category         String?
  /// Optional sub-category slug within the category (e.g. "gaming" under laptops).
  subcategory      String?

  shortDescription String?
  description      String?
  whoFor           String?
  whyRecommend     String?

  imageUrl         String?
  imageAlt         String?
  gallery          String[] @default([])

  /// Indicative reference price only — the real price is shown on Amazon.
  price            Float?
  currency         String   @default("EUR")

  /// Only set when reliable — never fabricated.
  rating           Float?
  reviewCount      Int?

  features         String[] @default([])
  pros             String[] @default([])
  cons             String[] @default([])
  tags             String[] @default([])
  related          String[] @default([])
  guides           String[] @default([])

  specs              Json    @default("[]")
  faqs               Json    @default("[]")
  amazonAvailability Json    @default("{}")

  /// Only store if legitimately known; never invent GTIN/UPC/EAN/SKU.
  sku       String?
  /// Global identifiers used for cross-provider product matching / deduplication.
  gtin      String?
  mpn       String?

  /// Offers from affiliate providers. Amazon per-country availability continues
  /// to live in `amazonAvailability`; other networks populate ProductOffer.
  offers    ProductOffer[]

  featured  Boolean @default(false)
  trending  Boolean @default(false)
  published Boolean @default(true)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([featured])
}

/// A single buy option for a MarketProduct from an affiliate provider/merchant
/// in a given country. Product ≠ Offer: one product can have many offers across
/// Amazon / Awin / impact.com / CJ, which is what makes offer-comparison and
/// multi-network support possible. Populated by provider sync jobs (once
/// credentials + program approvals exist); Amazon's own availability stays in
/// MarketProduct.amazonAvailability.
model ProductOffer {
  id                String        @id @default(cuid())
  productId         String
  product           MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// "amazon" | "awin" | "impact" | "cj"
  provider          String
  merchantId        String?
  merchantName      String?
  /// The provider's product identifier (ASIN / aw_product_id / CJ id / catalog item id).
  merchantProductId String?

  price             Float?
  originalPrice     Float?
  currency          String?
  availability      String?
  /// ISO country code the offer applies to.
  country           String

  destinationUrl    String?
  affiliateUrl      String?

  /// Program/merchant relationship: available | applied | approved | rejected | inactive
  programStatus     String?

  metadata          Json      @default("{}")
  lastSyncedAt      DateTime?
  sourceUpdatedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, merchantProductId, country])
  @@index([productId, country])
  @@index([provider])
  @@index([country])
}

/// Privacy-light on-site analytics events (no PII: no IP, no user agent, no
/// user id). Powers the admin dashboard: product/offer views, searches, country
/// selections and — most importantly — outbound affiliate clicks, broken down by
/// provider, country and product. Actual commissions live in each network's own
/// reporting; these events are the leading indicators we can measure ourselves.
/// A Telegram bot user. Stores the chat id + their chosen delivery country so
/// product replies localize the same way the website's "deliver to" selector
/// does. Saved/alerted products are added in a later phase.
model TelegramUser {
  id           String   @id @default(cuid())
  /// Telegram chat id (stored as string — ids can exceed 32-bit).
  chatId       String   @unique
  username     String?
  firstName    String?
  /// Delivery country code (see lib/marketplace COUNTRIES). Defaults to site default.
  country      String   @default("DE")
  /// Last deep-link /start payload (e.g. "alert_<productId>"), for later phases.
  startPayload String?
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([country])
}

/// A published (or attempted) Pinterest pin. Prevents duplicate pins of the same
/// item and powers the Pinterest report. Unique per (itemType, itemSlug) so each
/// product/course is pinned once; re-pins rotate the image variant.
model PinLog {
  id        String   @id @default(cuid())
  itemType  String // product | course
  itemSlug  String
  variant   Int      @default(1)
  boardId   String?
  pinId     String?
  imageUrl  String?
  link      String?
  status    String // success | error
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemType, itemSlug])
  @@index([status, createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  /// product_view | category_view | guide_view | comparison_view |
  /// marketplace_search | offer_view | buy_click | country_selected
  type        String
  productSlug String?
  category    String?
  /// Affiliate provider for buy_click (amazon | awin | impact | cj).
  provider    String?
  merchant    String?
  /// ISO country code (from selection or edge geo).
  country     String?
  path        String?
  query       String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([country])
  @@index([provider])
  @@index([productSlug])
}

/// NBN MARKET — Online Course (a digital affiliate product).
///
/// Kept separate from MarketProduct because courses have their own field set
/// (instructor, duration, level, certificate, curriculum) and their own
/// provider-agnostic affiliate model. A course is sold on an external platform
/// (Udemy, Coursera, …) reached via an affiliate network (Impact, …); the app
/// never processes payments. `category` / `provider` / `affiliateNetwork` are
/// free-form slugs/strings (see lib/courses.ts) so new categories and networks
/// can be added in config without a schema change.
///
/// `affiliateUrl` holds the FINAL tracked link generated in the affiliate
/// network (e.g. the Impact-generated Udemy link) — the frontend never builds
/// it. When empty, the CTA shows a disabled "link coming soon" state.
///
/// JSON fields:
///   countryAvailability — { "US": true, ... } (optional; digital courses are
///                         global by default, so an empty object means "all").
model Course {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?
  shortDescription String?

  /// Platform the course is sold on (e.g. "Udemy", "Coursera"). Free-form.
  provider         String   @default("Udemy")
  /// Affiliate network the link is tracked through (e.g. "Impact", "Amazon Associates").
  affiliateNetwork String   @default("Impact")
  /// Final tracked affiliate URL (generated in the network). Empty until set.
  affiliateUrl     String?

  image            String?
  imageAlt         String?

  /// Category slug (see lib/courses.ts). Sub-category is a free-form slug.
  category         String?
  subcategory      String?

  instructor       String?

  /// Prices are shown as provided; the storefront localizes the displayed value.
  price            Float?
  currency         String   @default("USD")
  originalPrice    Float?
  discountPercentage Int?

  /// Only store when legitimately known; never fabricated for real courses.
  rating           Float?
  reviewCount      Int?

  /// Human-readable duration label (e.g. "24 hours" / "24h 30m").
  duration         String?
  lectureCount     Int?
  /// "Beginner" | "Intermediate" | "Advanced" | "All Levels" (free-form).
  level            String?
  language         String   @default("English")
  certificateAvailable Boolean @default(false)
  bestseller       Boolean  @default(false)
  featured         Boolean  @default(false)
  /// Provider's "last updated" label (e.g. "2024-11"); string to avoid fake dates.
  lastUpdated      String?

  countryAvailability Json  @default("{}")
  tags             String[] @default([])
  whatYouLearn     String[] @default([])
  requirements     String[] @default([])

  /// Affiliate economics + external identifiers (for reporting / future syncs).
  commissionRate   Float?
  commissionType   String?
  trackingId       String?
  externalProductId String?
  externalProductUrl String?

  /// Clearly-labelled demo content until real affiliate courses are inserted.
  demo             Boolean  @default(false)
  published        Boolean  @default(true)
  order            Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([featured])
  @@index([provider])
}
